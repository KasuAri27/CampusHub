# 由运行环境或IDE配置这些环境变量；Spring Boot不会自动加载此示例文件。
CAMPUSHUB_DB_PASSWORD=
CAMPUSHUB_JWT_SECRET=
CAMPUSHUB_AES_KEY=
CAMPUSHUB_SMTP_USERNAME=
CAMPUSHUB_SMTP_PASSWORD=

# 微信普通商户需开通Native支付。商户私钥与微信支付公钥文件放仓库之外。
CAMPUSHUB_WECHAT_ENABLED=false
CAMPUSHUB_WECHAT_APP_ID=
CAMPUSHUB_WECHAT_MERCHANT_ID=
CAMPUSHUB_WECHAT_SERIAL=
CAMPUSHUB_WECHAT_PRIVATE_KEY_PATH=
CAMPUSHUB_WECHAT_PUBLIC_KEY_PATH=
CAMPUSHUB_WECHAT_PUBLIC_KEY_ID=
CAMPUSHUB_WECHAT_API_V3_KEY=
CAMPUSHUB_WECHAT_NOTIFY_URL=https://your-domain.example/api/v1/payments/notify/wechat

# 支付宝普通商户需签约当面付；本版使用RSA2公钥模式。
CAMPUSHUB_ALIPAY_ENABLED=false
CAMPUSHUB_ALIPAY_SANDBOX=false
CAMPUSHUB_ALIPAY_APP_ID=
CAMPUSHUB_ALIPAY_SELLER_ID=
CAMPUSHUB_ALIPAY_PRIVATE_KEY_PATH=
CAMPUSHUB_ALIPAY_PUBLIC_KEY_PATH=
CAMPUSHUB_ALIPAY_NOTIFY_URL=https://your-domain.example/api/v1/payments/notify/alipay

# 私有凭证目录需要持久化、备份，只通过管理员鉴权下载，不挂载到公开静态目录。
CAMPUSHUB_SETTLEMENT_EVIDENCE_DIR=private-storage/settlements
